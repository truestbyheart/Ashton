
{{! --- Header Partial with Alpine.js Mobile Drawer --- }}

{{! 
  The x-data="{ open: false }" directive initializes the Alpine.js component.
  'open' will track the state of the mobile menu (true = open, false = closed).
}}
<header class="bg-white shadow-sm sticky top-0 z-50" x-data="{ open: false }">
    <div class="mx-auto px-4 py-4 flex items-center justify-between gap-4">

        <!-- 1. Site Logo & Title -->
        <a href="{{@site.url}}" class="flex items-center shrink-0" aria-label="Home">
            {{#if @site.logo}}
                <img src="{{@site.logo}}" alt="{{@site.title}}" class="h-10 w-auto"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';">
                <span class="text-lg font-bold tracking-wider" style="display:none;">{{@site.title}}</span>
            {{else}}
                <span class="text-lg font-bold tracking-wider">{{@site.title}}</span>
            {{/if}}
        </a>

        <!-- 2. Desktop Navigation & Search -->
        <div class="hidden md:flex items-center justify-end space-x-4">
            <!-- Dynamic Navigation (from Ghost Admin) -->
            <nav class="flex space-x-2">
                {{#foreach @site.navigation}}
                <a href="{{url}}" class="px-3 py-2 rounded-md hover:bg-gray-100 font-medium text-sm uppercase">{{label}}</a>
                {{/foreach}}
            </nav>

            <!-- Desktop Search Button (Icon) -->
            <button data-ghost-search class="text-gray-700 hover:text-gray-900 p-2" aria-label="Search">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                    stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
            </button>
        </div>

        <!-- 3. Mobile Hamburger Button -->
        <!-- This button toggles the 'open' variable from false to true and back -->
        <button @click="open = !open" class="md:hidden flex items-center px-2 py-1 border rounded text-gray-700 border-gray-300"
            aria-label="Open navigation">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>

    </div>

    <!-- 
      4. Mobile Navigation Drawer 
      This whole section is hidden by default.
      - x-show="open": Makes it visible when 'open' is true.
      - x-cloak: Prevents it from "flashing" on page load before Alpine.js hides it.
      - @keydown.escape.window="open = false": Allows users to close the menu with the Escape key.
    -->
    <div x-show="open" x-cloak @keydown.escape.window="open = false" class="fixed inset-0 z-50 md:hidden"
        aria-modal="true">

        <!-- 4a. Overlay Backdrop -->
        <!-- 
          - @click="open = false": Closes the menu if the user clicks on the dark background.
          - x-transition:enter...: Smoothly fades the background in.
          - x-transition:leave...: Smoothly fades the background out.
        -->
        <div x-show="open" @click="open = false" x-transition:enter="transition-opacity ease-out duration-300"
            x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
            x-transition:leave="transition-opacity ease-in duration-200" x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0" class="absolute inset-0 bg-black/60"></div>

        <!-- 4b. Slide-out Panel -->
        <!--
          - x-transition:enter...: Smoothly slides the panel in from the right.
          - x-transition:leave...: Smoothly slides the panel out to the right.
        -->
        <nav x-show="open" x-transition:enter="transform transition ease-out duration-300"
            x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
            x-transition:leave="transform transition ease-in duration-200" x-transition:leave-start="translate-x-0"
            x-transition:leave-end="translate-x-full"
            class="relative ml-auto h-full w-full max-w-sm bg-white shadow-xl flex flex-col p-6">

            <!-- Drawer Header -->
            <div class="flex items-center justify-between pb-4 border-b border-gray-200">
                <span class="font-bold uppercase">Menu</span>
                <button @click="open = false" class="p-1 text-gray-500 hover:text-gray-700" aria-label="Close menu">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Mobile Navigation Links -->
            <div class="grow flex flex-col justify-center items-center gap-2 mt-4">
                {{#foreach @site.navigation}}
                <a href="{{url}}" @click="open = false"
                    class="block w-full px-4 py-3 rounded-md hover:bg-gray-100 font-medium text-lg text-center">{{label}}</a>
                {{/foreach}}
            </div>

            <!-- Mobile Search Button (at the bottom of the drawer) -->
            <button data-ghost-search @click="open = false"
                class="flex flex-row items-center justify-center gap-2 px-4 py-3 w-full border text-black/60  border-gray-300 bg-gray-50 rounded-lg cursor-pointer hover:bg-gray-100"
                aria-label="Search">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
                    stroke="currentColor" class="flex-[0_0_auto] w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
                Search
            </button>

        </nav>
    </div>
</header>