<section class="bg-gray-50 py-12 px-4 md:px-8 mt-12">
    <div class="max-w-4xl mx-auto rounded-2xl p-8 bg-white shadow-lg">
        <h2 class="text-2xl font-bold mb-4">Subscribe to Newsletter</h2>
        <p class="text-gray-600 mb-6">Join me on this exciting journey as we explore the boundless world of web design
            together.</p>
        <form id="footer-submit" class="flex flex-col sm:flex-row gap-4" data-members-form x-data="footerNewsletterForm()"
            @submit.prevent="submitForm">
            <div class="flex-1 relative">
                <input data-members-email type="email" placeholder="Type your email..." @focus="hasError = false"
                    :disabled="isLoading"
                    class="w-full px-4 py-2 border border-gray-300 rounded-full focus:outline-none focus:ring-2 focus:ring-gray-800 disabled:opacity-50 disabled:cursor-not-allowed transition-all">
            </div>
            <button type="submit" :disabled="isLoading"
                class="px-6 py-2 bg-black text-white rounded-full hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center justify-center gap-2 whitespace-nowrap">
                <span x-show="!isLoading">Subscribe</span>
                <span x-show="isLoading" class="flex items-center gap-1">
                    <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                        </circle>
                        <path class="opacity-75" fill="currentColor"
                            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                        </path>
                    </svg>
                </span>
            </button>
        </form>
    </div>
</section>

<!-- Snackbar Notification -->
<div id="snackbar-newsletter" x-data="{ show: false, message: '', type: 'success' }"
    @show-snackbar-newsletter.window="show = true; message = $event.detail.message; type = $event.detail.type; setTimeout(() => show = false, 4000)"
    x-show="show" x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-2" :class="{
        'bg-green-50 border border-green-200': type === 'success',
        'bg-red-50 border border-red-200': type === 'error'
    }" class="fixed bottom-4 right-4 px-4 py-3 rounded-lg shadow-lg z-50 max-w-sm">
    <div class="flex items-start gap-3">
        <div :class="type === 'success' ? 'text-green-600' : 'text-red-600'">
            <svg x-show="type === 'success'" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd" />
            </svg>
            <svg x-show="type === 'error'" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                    clip-rule="evenodd" />
            </svg>
        </div>
        <div class="text-left flex-1">
            <p :class="type === 'success' ? 'text-green-800' : 'text-red-800'" class="text-sm font-medium"
                x-text="message"></p>
        </div>
        <button @click="show = false" class="ml-auto shrink-0">
            <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd"
                    d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                    clip-rule="evenodd" />
            </svg>
        </button>
    </div>
</div>

<script>
    function footerNewsletterForm() {
        return {
            isLoading: false,
            hasError: false,
            async submitForm() {
                const form = this.$el;
                const emailInput = form.querySelector('#footer-submit input[data-members-email]');
                const email = emailInput.value.trim();

                if (!email) {
                    this.showSnackbar('Please enter a valid email address', 'error');
                    return;
                }

                this.isLoading = true;

                try {
                    const response = await fetch('/members/api/send-magic-link/', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ email: email })
                    });

                    if (response.ok) {
                        this.showSnackbar('✓ Check your email to confirm subscription!', 'success');
                        emailInput.value = '';
                        form.reset();
                    } else {
                        const error = await response.json();
                        const message = error.message || 'Subscription failed. Please try again.';
                        this.showSnackbar(message, 'error');
                        this.hasError = true;
                    }
                } catch (error) {
                    this.showSnackbar('Network error. Please try again later.', 'error');
                    this.hasError = true;
                    console.error('Newsletter subscription error:', error);
                } finally {
                    this.isLoading = false;
                }
            },
            showSnackbar(message, type = 'success') {
                window.dispatchEvent(new CustomEvent('show-snackbar-newsletter', {
                    detail: { message, type }
                }));
            }
        };
    }
</script>