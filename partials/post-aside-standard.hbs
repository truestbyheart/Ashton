                        stroke="currentColor" stroke-linejoin="round" />
                </svg>
            </a>
            {{/if}}
            {{#if youtube}}
            <a href="https://youtube.com/{{youtube}}" class="social-links" target="_blank" rel="noopener noreferrer"
                aria-label="YouTube">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                        d="M22.54 6.42a2.765 2.765 0 0 0-1.945-1.957C18.88 4 12 4 12 4s-6.88 0-8.595.463A2.765 2.765 0 0 0 1.46 6.42C1 8.148 1 11.75 1 11.75s0 3.602.46 5.33a2.765 2.765 0 0 0 1.945 1.958C5.121 19.5 12 19.5 12 19.5s6.88 0 8.595-.462a2.765 2.765 0 0 0 1.945-1.958c.46-1.726.46-5.33.46-5.33s0-3.602-.46-5.33ZM9.75 8.479v6.542l5.75-3.271-5.75-3.271Z"
                        fill="currentColor" />
                </svg>
            </a>
            {{/if}}
        </div>
        {{/primary_author}}
    </div>

    <div class="p-6 bg-gray-50 rounded-lg text-center">
        <h4 class="font-bold text-lg">Newsletter</h4>
        <p class="text-gray-600 mt-2 text-sm">Subscribe to get my latest posts and updates.</p>
        <form class="mt-4" data-members-form x-data="newsletterForm()" @submit.prevent="submitForm">
            <div class="relative">
                <input data-members-email type="email" required="true" name="email" placeholder="Your email"
                    @focus="hasError = false" :disabled="isLoading"
                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-800 disabled:opacity-50 disabled:cursor-not-allowed transition-all">
            </div>
            <button type="submit" :disabled="isLoading"
                class="mt-3 w-full bg-black text-white py-2 text-sm uppercase rounded-md hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center justify-center gap-2">
                <span x-show="!isLoading">Subscribe</span>
                <span x-show="isLoading" class="flex items-center gap-1">
                    <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                        </circle>
                        <path class="opacity-75" fill="currentColor"
                            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                        </path>
                    </svg>
                    Subscribing...
                </span>
            </button>
        </form>
    </div>

    <!-- Snackbar Notification -->
    <div id="snackbar" x-data="{ show: false, message: '', type: 'success' }"
        @show-snackbar.window="show = true; message = $event.detail.message; type = $event.detail.type; setTimeout(() => show = false, 4000)"
        x-show="show" x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 translate-y-2" :class="{
            'bg-green-50 border border-green-200': type === 'success',
            'bg-red-50 border border-red-200': type === 'error'
        }" class="fixed bottom-4 right-4 px-4 py-3 rounded-lg shadow-lg z-50 max-w-sm">
        <div class="flex items-start gap-3">
            <div :class="type === 'success' ? 'text-green-600' : 'text-red-600'">
                <svg x-show="type === 'success'" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd" />
                </svg>
                <svg x-show="type === 'error'" class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                        clip-rule="evenodd" />
                </svg>
            </div>
            <div class="text-left">
                <p :class="type === 'success' ? 'text-green-800' : 'text-red-800'" class="text-sm font-medium"
                    x-text="message"></p>
            </div>
            <button @click="show = false" class="ml-auto">
                <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                        d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                        clip-rule="evenodd" />
                </svg>
            </button>
        </div>
    </div>

    <script>
        function newsletterForm() {
            return {
                isLoading: false,
                hasError: false,
                async submitForm() {
                    const form = this.$el;
                    const emailInput = form.querySelector('[data-members-email]');
                    const email = emailInput.value.trim();

                    if (!email) {
                        this.showSnackbar('Please enter a valid email address', 'error');
                        return;
                    }

                    this.isLoading = true;

                    try {
                        const response = await fetch('/members/api/send-magic-link/', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ email: email })
                        });

                        if (response.ok) {
                            this.showSnackbar('✓ Check your email to confirm subscription!', 'success');
                            emailInput.value = '';
                            form.reset();
                        } else {
                            const error = await response.json();
                            const message = error.message || 'Subscription failed. Please try again.';
                            this.showSnackbar(message, 'error');
                            this.hasError = true;
                        }
                    } catch (error) {
                        this.showSnackbar('Network error. Please try again later.', 'error');
                        this.hasError = true;
                        console.error('Newsletter subscription error:', error);
                    } finally {
                        this.isLoading = false;
                    }
                },
                showSnackbar(message, type = 'success') {
                    window.dispatchEvent(new CustomEvent('show-snackbar', {
                        detail: { message, type }
                    }));
                }
            };
        }
    </script>

</div>