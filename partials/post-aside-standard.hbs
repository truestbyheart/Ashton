<div class="sticky top-24 space-y-8">
    <div class="p-6 bg-gray-50 rounded-lg text-center">
        {{#primary_author}}
        <div class="flex justify-center">
            {{#if profile_image}}
            <img src="{{profile_image}}" alt="{{name}}" class="w-16 h-16 rounded-full mb-4">
            {{else}}
            <img src="{{ asset 'images/default_avatar_612.jpg'}}" alt="Author" class="w-16 h-16 rounded-full mb-4">
            {{/if}}
        </div>
        <h4 class="text-xl font-bold mt-4">{{name}}</h4>
        <p class="text-gray-600 mt-2 text-sm">{{bio}}</p>
        <div class="flex justify-center gap-3 mt-4">
            {{#if website}}
            <a href="{{website}}" class="social-links" target="_blank" rel="noopener noreferrer" aria-label="Website">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M1.66666 10.0001H18.3333M1.66666 10.0001C1.66666 14.6024 5.39762 18.3334 10 18.3334M1.66666 10.0001C1.66666 5.39771 5.39762 1.66675 10 1.66675M18.3333 10.0001C18.3333 14.6024 14.6023 18.3334 10 18.3334M18.3333 10.0001C18.3333 5.39771 14.6023 1.66675 10 1.66675M10 18.3334C12.0844 16.0514 13.269 13.0901 13.3333 10.0001C13.269 6.91011 12.0844 3.94871 10 1.66675M10 18.3334C7.9156 16.0514 6.73104 13.0901 6.66666 10.0001C6.73104 6.91011 7.9156 3.94871 10 1.66675"
                        stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </a>
            {{/if}}
            {{#if twitter}}
            <a href="https://x.com/{{twitter}}" class="social-links" target="_blank" rel="noopener noreferrer"
                aria-label="Twitter">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M18.2437 2.25H21.5531L14.325 10.5094L22.8281 21.75H16.1719L10.9547 14.9344L4.99216 21.75H1.6781L9.40779 12.9141L1.25623 2.25H8.08123L12.7922 8.47969L18.2437 2.25ZM17.0812 19.7719H18.914L7.08279 4.125H5.11404L17.0812 19.7719Z"
                        fill="currentColor"></path>
                </svg>
            </a>
            {{/if}}
            {{#if facebook}}
            <a href="https://facebook.com/{{facebook}}" class="social-links" target="_blank" rel="noopener noreferrer"
                aria-label="Facebook">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M22.675 0H1.325C0.59375 0 0 0.59375 0 1.325V22.675C0 23.4062 0.59375 24 1.325 24H12.825V14.7083H9.69271V11.0833H12.825V8.41354C12.825 5.34896 14.6635 3.70833 17.3304 3.70833C18.6354 3.70833 19.7982 3.80208 20.1125 3.84375V7.02083H18.3304C16.8477 7.02083 16.575 7.73958 16.575 8.80208V11.0833H20L19.475 14.7083H16.575V24H22.675C23.4062 24 24 23.4062 24 22.675V1.325C24 0.59375 23.4062 0 22.675 0Z"
