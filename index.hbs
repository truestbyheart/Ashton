{{!< default}} {{> navigation }}
    <!-- Hero Post Banner -->
    {{> post-slider}}

    <!-- Latest Posts -->
    <section class="py-8 px-4 md:px-8">
        <h2 class="text-2xl font-bold mb-6">Latest</h2>
        <div id="post-feed" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {{#foreach posts}}
            <a href="{{url}}">
                {{> post-card}}
            </a>
            {{/foreach}}
        </div>

        <div class="mt-10 text-center">
            {{pagination}}
        </div>
    </section>

    <!-- Our Authors -->
    <section class="py-8 px-4 md:px-8">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold">Our Authors</h2>
            <a href="/authors" class="px-4 py-2 bg-gray-100 rounded-full text-sm hover:bg-gray-200 transition">All
                Authors →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-6">

            {{#get "authors" include="count"}}
            {{#foreach authors limit="6"}}
            {{> author-card}}
            {{/foreach}}
            {{/get}}
        </div>
    </section>

    {{> newsletter}}

    {{> footer }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Find the elements
            const postFeed = document.getElementById('post-feed');
            const loadMoreLink = document.getElementById('load-more-link');

            // If there's no "load more" link (e.g., last page), do nothing
            if (!loadMoreLink) {
                return;
            }

            // Add a click event listener
            loadMoreLink.addEventListener('click', async function (e) {
                // Prevent the link from navigating normally
                e.preventDefault();

                // Get the URL of the next page from the link's href
                let nextPageUrl = loadMoreLink.href;

                // Show a loading state
                loadMoreLink.innerText = 'Loading...';
                loadMoreLink.style.pointerEvents = 'none';

                try {
                    // Fetch the HTML of the next page
                    const response = await fetch(nextPageUrl);
                    const text = await response.text();

                    // Use DOMParser to convert the text into an HTML document
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(text, 'text/html');

                    // Find the new posts on the fetched page
                    const newPosts = doc.querySelectorAll('#post-feed > a');

                    // Append each new post to the current grid
                    newPosts.forEach(post => {
                        postFeed.appendChild(post);
                    });

                    // Find the "load more" link on the *fetched* page
                    const newLoadMoreLink = doc.getElementById('load-more-link');

                    if (newLoadMoreLink) {
                        // If a new link exists, update the current one's URL
                        loadMoreLink.href = newLoadMoreLink.href;
                        loadMoreLink.innerText = 'Load More'; // Reset text
                        loadMoreLink.style.pointerEvents = 'auto';
                    } else {
                        // If no new link exists, we've reached the end.
                        loadMoreLink.remove(); // Remove the button
                    }
                } catch (error) {
                    console.error('Error fetching new posts:', error);
                    loadMoreLink.innerText = 'Error - Retry?'; // Show an error
                    loadMoreLink.style.pointerEvents = 'auto';
                }
            });
        });
    </script>