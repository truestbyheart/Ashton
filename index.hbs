<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{meta_title}}</title>
    <link rel="stylesheet" href="{{asset "css/output.css"}}">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
{{!-- {{!< default}} --}}


<body class="font-sans bg-white text-gray-800">

    {{> head }}

    <!-- Hero Post Banner -->
    <div class="w-[1692px] height-[500px] rounded-2xl mx-auto mt-8">
    {{^is "paged"}}
    {{#get "posts" limit="4" filter="featured:true"}} {{! Fetch up to 4 featured posts }}
    {{#if posts}}
    <div class="swiper">
        <div class="swiper-wrapper w-full h-full">
            {{#foreach posts}}
                <section class="swiper-slide rounded-2xl">
                    <div class="absolute inset-0 bg-black/50 z-10"></div>
                    <img src="{{feature_image}}" alt="{{title}}"
                        class="w-full h-[400px] rounded-2xl object-cover">
                    <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10 z-20 text-white text-center">
                        <div class="text-sm opacity-80 mb-2">
                            {{#foreach tags}}<span>{{name}}</span>{{#unless @last}} • {{/unless}}{{/foreach}}
                        </div>
                        <h2 class="text-3xl md:text-5xl font-bold leading-tight mb-4">{{title}}</h2>
                        <div class="flex items-center justify-center">
                            <p class="text-lg md:text-xl max-w-3xl mb-6">{{excerpt}}</p>
                        </div>
                        <div class="flex items-center justify-center gap-4 text-sm opacity-90">
                            <div class="flex -space-x-2">
                                {{#foreach authors}}
                                    <img src="{{profile_image}}" alt="{{name}}" class="w-8 h-8 rounded-full border-2 border-white">
                                {{/foreach}}
                            </div>
                            <span>{{primary_author.name}} • {{date published_at format="MMM
                                D, YYYY"}} • {{reading_time}}</span>
                        </div>
                    </div>
                </section>
            {{/foreach}}
        </div>
        <div class="swiper-pagination"></div>
    </div>
    {{/if}}
    {{/get}}
    {{/is}}
    </div>

    <!-- Latest Posts -->
    <section class="py-8 px-4 md:px-8">
        <h2 class="text-2xl font-bold mb-6">Latest</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {{#foreach posts}}
            <a href="{{url}}">
                {{> post-card}}
            </a>
            {{/foreach}}
        </div>

        <!-- Load More Button -->
        <div class="mt-10 text-center">
            <button class="px-6 py-2 border border-gray-300 rounded-md hover:bg-gray-50 transition">Load More</button>
        </div>
    </section>

    <!-- Our Authors -->
    <section class="py-8 px-4 md:px-8">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold">Our Authors</h2>
            <a href="/authors" class="px-4 py-2 bg-gray-100 rounded-full text-sm hover:bg-gray-200 transition">All
                Authors →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-6">

            {{#get "authors" include="count"}}
            {{#foreach authors limit="6"}}
            {{> author-card}}
            {{/foreach}}
            {{/get}}
        </div>
    </section>

    {{> newsletter}}

    {{> footer }}

</body>

</html>