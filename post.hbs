<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{meta_title}}</title>
    <link rel="stylesheet" href="{{asset "css/output.css"}}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tocbot/4.32.2/tocbot.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    {{ghost_head}}
</head>
<body class="bg-white text-gray-800 font-sans">

    {{! This is a Handlebars template, assuming a Ghost-like context }}
    {{! The main post content starts here }}
    {{#post}}

    {{> head}}

    <div class="container mx-auto px-4 mt-10">
        <header class="flex flex-col">
            <div class="mb-6 lg:order-1 sm:mb-0 max-sm:mb-0 sm:order-2 max-sm:order-2 sm:mt-4 max-sm:mt-4">
                <div class="flex flex-row">
                    {{#get "authors" filter="slug:{{primary_author.slug}}" limit="2"}}
                        {{#foreach authors}}
                            {{#if profile_image}}
                                <img src="{{profile_image}}" alt="{{name}}" class="w-16 h-16 rounded-full mb-4">
                            {{else}}
                                <img src="https://placehold.co/100x100/4a5568/e2e8f0" alt="Author" class="w-16 h-16 rounded-full mb-4">
                            {{/if}}
                        {{/foreach}}
                    {{/get}}
                    <div class="ml-6">
                        <h1 class="text-5xl font-bold my-2" style="font-size: 1.2345rem;">{{title}}</h1>
                        <div class="flex flex-row gap-1 text-gray-600 mt-2 text-sm">
                        {{#get "authors" filter="slug:{{primary_author.slug}}"}}
                            by
                            {{#foreach authors}}
                                <div class="">
                                    <span class="font-light">{{name}} • </span>
                                </div>
                            {{/foreach}}
                            <span class="text-sm text-gray-500">{{date published_at format="MMM D, YYYY"}} • {{reading_time}}</span>
                        {{/get}}
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:w-full lg:h-auto sm:h-[200px] max-sm:h-[100px] overflow-hidden rounded-2xl sm:order-1 max-sm:order-1 ">
                {{#if feature_image}}
                    <img src="{{feature_image}}" alt="{{title}}" class="w-full h-[500px] rounded-2xl object-cover">
                {{else}}
                        <img src="https://placehold.co/1000x600/1a1a1a/404040" alt="Placeholder Image" class="w-full h-auto">
                {{/if}}
            </div>
        </header>

        <main class="grid grid-cols-4 gap-3 mt-5 relative">
            <article class="lg:col-span-3 sm:col-span-4 max-sm:col-span-4">
                <section class="post-content text-lg leading-relaxed text-gray-700 mt-6">
                    {{content}}
                </section>

                <footer class="mt-12 pt-8 border-t border-gray-200">
                    {{#if tags}}
                    <div class="flex items-center">
                        <span class="font-bold mr-4">Tags:</span>
                        <div class="flex flex-wrap gap-2">
                            {{#foreach tags}}
                            <a href="{{url}}" class="inline-block bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm hover:bg-gray-200">#{{name}}</a>
                            {{/foreach}}
                        </div>
                    </div>
                    {{/if}}
                </footer>
            </article>
            <aside class="lg:col-span-1 lg:block  sm:hidden max-sm:hidden">
                <div class="sticky top-24 space-y-8">
                    <div class="p-6 bg-gray-50 rounded-lg text-center">
                        {{#get "authors" filter="slug:{{primary_author.slug}}" limit="1"}}
                        {{#foreach authors}}
                            <div class="flex justify-center">
                                {{#if profile_image}}
                                    <img src="{{profile_image}}" alt="{{name}}" class="w-16 h-16 rounded-full mb-4">
                                {{else}}
                                    <img src="{{ asset "images/default_avatar_612.jpg"}}" alt="Author" class="w-16 h-16 rounded-full mb-4">
                                {{/if}}
                            </div>
                            <h4 class="text-xl font-bold mt-4">{{name}}</h4>
                            <p class="text-gray-600 mt-2 text-sm">{{bio}}</p>
                            <div class="flex justify-center space-x-4 mt-4 text-gray-500">
                                <a href="#" class="hover:text-gray-800">Tw</a>
                                <a href="#" class="hover:text-gray-800">In</a>
                                <a href="#" class="hover:text-gray-800">Fb</a>
                            </div>
                        {{/foreach}}
                        {{/get}}
                    </div>

                    <div class="toc p-4">
                        <div class="flex flex-row gap-2 items-center text-bold font-semibold mb-2">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <line x1="1.25" y1="4.25" x2="10.75" y2="4.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
                                <line x1="3.25" y1="8.25" x2="12.75" y2="8.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
                                <line x1="5.25" y1="12.25" x2="14.75" y2="12.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
                            </svg>
                            On this page
                        </div>
                        <div class="toc-list"></div>
                    </div>

                    <div class="p-6 bg-gray-50 rounded-lg text-center">
                        <h4 class="font-bold text-lg">Newsletter</h4>
                        <p class="text-gray-600 mt-2 text-sm">Subscribe to get my latest posts and updates.</p>
                        <form action="#" method="post" class="mt-4">
                            <input type="email" name="email" placeholder="Your email" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-800" required>
                            <button type="submit" class="mt-3 w-full bg-black text-white py-2 text-sm uppercase rounded-md hover:bg-gray-800">Subscribe</button>
                        </form>
                    </div>

                </div>
            </aside>
        </main>

    </div>
    {{/post}}

    <a href="#" class="fixed bottom-10 right-10 hidden lg:block p-3 bg-gray-800 text-white rounded-full shadow-lg hover:bg-gray-600 transition-colors z-40">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5l7.5-7.5 7.5 7.5" />
        </svg>
    </a>

    <section class="mt-20 py-20 border-t border-gray-200">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-12">More Posts</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                {{! This is a Ghost helper to fetch 4 other posts }}
                {{#get "posts" filter="id:-{{post.id}}" limit="4" include="tags,authors"}}
                    {{#foreach posts}}
                    <div>
                        <a href="{{url}}">
                            {{#if feature_image}}
                                <img src="{{feature_image}}" alt="{{title}}" class="w-full h-64 object-cover">
                            {{else}}
                                <img src="https://placehold.co/400x300/e5e7eb/9ca3af" alt="Placeholder" class="w-full h-64 object-cover">
                            {{/if}}
                        </a>
                        <h3 class="font-bold text-lg mt-4"><a href="{{url}}">{{title}}</a></h3>
                        {{#primary_tag}}
                            <p class="text-sm text-gray-500 uppercase mt-1">{{name}}</p>
                        {{/primary_tag}}
                    </div>
                    {{/foreach}}
                {{/get}}

                {{! Fallback static cards if not using Ghost }}
                {{^get "posts" limit="4"}}
                    <div>
                        <a href="#"><img src="https://placehold.co/400x300/d1fae5/10b981" alt="Related post 1" class="w-full h-64 object-cover"></a>
                        <h3 class="font-bold text-lg mt-4">Post Title One</h3>
                        <p class="text-sm text-gray-500 uppercase mt-1">Category</p>
                    </div>
                    <div>
                        <a href="#"><img src="https://placehold.co/400x300/cffafe/06b6d4" alt="Related post 2" class="w-full h-64 object-cover"></a>
                        <h3 class="font-bold text-lg mt-4">Post Title Two</h3>
                        <p class="text-sm text-gray-500 uppercase mt-1">Category</p>
                    </div>
                    <div>
                        <a href="#"><img src="https://placehold.co/400x3A00/e0e7ff/6366f1" alt="Related post 3" class="w-full h-64 object-cover"></a>
                        <h3 class="font-bold text-lg mt-4">Post Title Three</h3>
                        <p class="text-sm text-gray-500 uppercase mt-1">Category</p>
                    </div>
                    <div>
                        <a href="#"><img src="https://placehold.co/400x300/f3e8ff/a855f7" alt="Related post 4" class="w-full h-64 object-cover"></a>
                        <h3 class="font-bold text-lg mt-4">Post Title Four</h3>
                        <p class="text-sm text-gray-500 uppercase mt-1">Category</p>
                    </div>
                {{/get}}

            </div>
        </div>
    </section>

    <script src="{{ asset "vendors/js/jquery-3.7.1.min.js" }}"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tocbot/4.32.2/tocbot.min.js"></script>
    <script>
        tocbot.init({
            tocSelector: '.toc-list',
            contentSelector: '.post-content',
            headingSelector: 'h1, h2, h3, h4, h5, h6',
            collapseDepth: 6
        });
    </script>
    {{ghost_footer}}
</body>
</html>
